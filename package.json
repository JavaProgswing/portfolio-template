{
  "name": "my-portfolio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "license": "MIT",
  "author": "Yashasvi Allen Kujur",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "fetch-repos": "node scripts/fetch-repos.mjs",
    "probe-deploys": "node scripts/probe-deploys.mjs",
    "resume:check": "node scripts/sync-resume.mjs --check",
    "resume:sync": "node scripts/sync-resume.mjs",
    "predeploy:prod": "npm run resume:sync && npm run probe-deploys && npm run build",
    "deploy:prod": "vercel --prod",
    "predev": "node scripts/init-data.mjs",
    "prebuild": "node scripts/init-data.mjs",
    "setup:ssh": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/setup-ssh-key.ps1",
    "deploy:ssh": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/deploy-ssh.ps1"
  },
  "dependencies": {
    "@chakra-ui/react": "^2.10.9",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "framer-motion": "^12.19.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-icons": "^5.5.0",
    "react-router-dom": "^6.30.3",
    "vercel": "^54.10.2"
  },
  "devDependencies": {
    "@types/react": "^18.0.27",
    "@types/react-dom": "^18.0.10",
    "@vitejs/plugin-react": "^3.1.0",
    "typescript": "^4.9.3",
    "vite": "^4.1.0"
  }
}
